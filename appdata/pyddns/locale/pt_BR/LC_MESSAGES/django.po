msgstr "Sua conta de administrador deve usar autenticação em duas etapas. Configure-a para continuar."

msgid "Scan the QR code with an authenticator app, then enter the code it shows."
msgstr "Escaneie o QR code com um app autenticador e digite o código exibido."

msgid "Install an authenticator app (Google Authenticator, Aegis, 1Password, Authy, ...)."
msgstr "Instale um app autenticador (Google Authenticator, Aegis, 1Password, Authy, ...)."

msgid "Scan this QR code, or type the key below."
msgstr "Escaneie este QR code ou digite a chave abaixo."

msgid "Enter the 6-digit code to confirm."
msgstr "Digite o código de 6 dígitos para confirmar."

msgid "QR code"
msgstr "QR code"

msgid "Setup key"
msgstr "Chave de configuração"

msgid "Verify and enable"
msgstr "Verificar e ativar"

msgid "Backup codes"
msgstr "Códigos de backup"

msgid "Save these codes somewhere safe. Each one works once if you lose access to your authenticator app. They will not be shown again."
msgstr "Guarde estes códigos em um lugar seguro. Cada um funciona uma vez se você perder o acesso ao app autenticador. Eles não serão exibidos novamente."

msgid "I have saved them"
msgstr "Já salvei"

msgid "%(n)s backup code left."
msgid_plural "%(n)s backup codes left."
msgstr[0] "Resta %(n)s código de backup."
msgstr[1] "Restam %(n)s códigos de backup."

msgid "Reset 2FA"
msgstr "Redefinir 2FA"

msgid "Reset two-factor authentication?"
