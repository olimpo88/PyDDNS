# --- Two-factor authentication ---

msgid "Enter the 6-digit code from your authenticator app, or one of your backup codes."
msgstr "Digite o código de 6 dígitos do seu app autenticador ou um dos seus códigos de backup."

msgid "Authentication code"
msgstr "Código de autenticação"

msgid "Verifying..."
msgstr "Verificando..."

msgid "Verify"
msgstr "Verificar"

msgid "Invalid code."
msgstr "Código inválido."

msgid "The verification expired. Please sign in again."
msgstr "A verificação expirou. Entre novamente."

msgid "Account disabled."
msgstr "Conta desativada."

msgid "Too many attempts. Try again later."
msgstr "Muitas tentativas. Tente novamente mais tarde."

msgid "Wrong password."
msgstr "Senha incorreta."

msgid "Two-factor authentication is required for administrators and cannot be disabled."
msgstr "A autenticação em duas etapas é obrigatória para administradores e não pode ser desativada."

msgid "Security"
msgstr "Segurança"

msgid "Two-factor authentication"
msgstr "Autenticação em duas etapas"

msgid "Add a one-time code from an authenticator app to your sign-in."
msgstr "Adicione ao seu login um código de uso único de um app autenticador."

msgid "Authenticator app"
msgstr "App autenticador"

msgid "Two-factor authentication is on for your account."
msgstr "A autenticação em duas etapas está ativada na sua conta."

msgid "Two-factor authentication is off."
msgstr "A autenticação em duas etapas está desativada."

msgid "Enabled"
msgstr "Ativada"

msgid "Disabled"
msgstr "Desativada"

msgid "Your administrator account must use two-factor authentication."
msgstr "Sua conta de administrador deve usar autenticação em duas etapas."

msgid "Set up two-factor authentication"
msgstr "Configurar a autenticação em duas etapas"

msgid "Generate new backup codes"
msgstr "Gerar novos códigos de backup"

