# --- Two-factor authentication ---

msgid "Enter the 6-digit code from your authenticator app, or one of your backup codes."
msgstr "認証アプリの6桁のコード、またはバックアップコードを入力してください。"

msgid "Authentication code"
msgstr "認証コード"

msgid "Verifying..."
msgstr "確認中..."

msgid "Verify"
msgstr "確認"

msgid "Invalid code."
msgstr "コードが正しくありません。"

